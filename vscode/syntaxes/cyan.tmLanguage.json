{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cyan",
  "scopeName": "source.cyan",
  "fileTypes": [
    "cyan"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#typeDeclarations"
    },
    {
      "include": "#contextualTypeKeywords"
    },
    {
      "include": "#builtinCalls"
    },
    {
      "include": "#functionNames"
    },
    {
      "include": "#memberAccess"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtinTypes"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cyan",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cyan",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.cyan"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.cyan"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.cyan",
              "match": "\\\\(?:['\"\\\\nrt0])"
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.cyan",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.character.begin.cyan"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.character.end.cyan"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.cyan",
              "match": "\\\\(?:['\"\\\\nrt0])"
            }
          ]
        }
      ]
    },
    "typeDeclarations": {
      "patterns": [
        {
          "name": "meta.declaration.type.cyan",
          "match": "\\b(struct|enum|interface)\\b\\s*(?:<[^>]+>\\s*)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.cyan"
            },
            "2": {
              "name": "entity.name.type.cyan"
            }
          }
        }
      ]
    },
    "functionNames": {
      "patterns": [
        {
          "name": "entity.name.function.cyan",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\()"
        }
      ]
    },
    "contextualTypeKeywords": {
      "patterns": [
        {
          "name": "storage.modifier.cyan",
          "match": "\\bshared\\b(?=\\s+(?:const\\s+)?(?:bool|char|f32|f64|i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|void|[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:<[^>]+>)?|\\())"
        }
      ]
    },
    "builtinCalls": {
      "patterns": [
        {
          "name": "support.function.builtin.cyan",
          "match": "\\b(?:len|subslice|atomic_relaxed|atomic_acquire|atomic_release|atomic_acq_rel|atomic_seq_cst|atomic_load|atomic_store|atomic_exchange|atomic_compare_exchange|atomic_fetch_add|atomic_fetch_sub|atomic_fetch_and|atomic_fetch_or|atomic_fetch_xor|atomic_fence)\\b(?=\\s*\\()"
        }
      ]
    },
    "memberAccess": {
      "patterns": [
        {
          "name": "variable.other.member.cyan",
          "match": "(?<=\\.)\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cyan",
          "match": "\\b(?:as|break|case|const|continue|default|depends|drop|else|export|extern|for|if|impl|import|move|mut|on|return|sizeof|switch|unchecked|while)\\b"
        }
      ]
    },
    "builtinTypes": {
      "patterns": [
        {
          "name": "storage.type.primitive.cyan",
          "match": "\\b(?:bool|char|f32|f64|i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|void)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.cyan",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.cyan",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    }
  }
}