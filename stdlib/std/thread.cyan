import /std.ptr as ptr;
import /std.abi;
import /std.err;
import /std.fmt;
import /std.heap as heap;
import /std.result;
import /std.view;

extern {
    i32 cyan_runtime_parallel_do(const void* tasks, i64 count);
    void* cyan_runtime_spawn(void* payload, void* run_fn, void* drop_fn);
    void cyan_runtime_join(void* handle);
    void cyan_runtime_detach(void* handle);
}

export interface<T> void run_task(&T task);
export interface<T> void run_once(&mut T task);
export interface thread_shared = share - local;
export interface thread_sendable = send - local;
export interface threaded_runnable = run_task + thread_shared;
export interface spawnable = run_once + thread_sendable;

export struct JoinHandle {
    void* raw;
};

unchecked impl send(JoinHandle);

export enum SpawnError {
    SpawnAllocFailed(heap.AllocError),
    SpawnRuntimeFailed,
};

impl err(&SpawnError value) {}

impl fmt(&SpawnError value, &mut StringBuilder out) {
    SpawnError copy = *value;
    switch (move copy) {
        case SpawnAllocFailed(error):
            fmt_write_cstr(out, "spawn allocation failed")?;
            fmt_write_cstr(out, ": ")?;
            return fmt(error, out);
        case SpawnRuntimeFailed:
            return fmt_write_cstr(out, "spawn runtime failed");
    }
}

SpawnError spawn_from_alloc(heap.AllocError error) {
    return SpawnAllocFailed(error);
}

void require_spawnable(&spawnable value) {}

void spawn_run_once<T>(T* task) {
    unchecked {
        &mut T borrowed = &mut *task;
        run_once(borrowed);
    }
}

void spawn_drop<T>(T* task) {
    unchecked {
        &mut T borrowed = &mut *task;
        drop(borrowed);
        heap.free_ptr(task);
    }
}

export void parallel_do([]&threaded_runnable tasks) {
    i64 count = len(tasks);
    if (count <= 0) {
        return;
    }
    if (count == 1) {
        run_task(tasks[0]);
        return;
    }
    unchecked {
        cyan_runtime_parallel_do(raw_data(tasks), count);
    }
}

export Result<JoinHandle, SpawnError> spawn<T>(T task) {
    require_spawnable(&mut task);

    T* payload;
    switch (move heap.malloc_array<T>(1)) {
        case Ok(memory):
            payload = memory;
        case Err(error):
            return Err(spawn_from_alloc(error));
    }

    unchecked {
        *payload = task;

        void* handle = cyan_runtime_spawn(payload as void*,
                                          fn_ptr<T>(spawn_run_once),
                                          fn_ptr<T>(spawn_drop));
        if (handle == ptr.null<void>()) {
            spawn_drop(payload);
            return Err(SpawnRuntimeFailed());
        }
        return Ok({handle});
    }
}

export void join(&mut JoinHandle handle) {
    if (handle.raw == ptr.null<void>()) {
        return;
    }
    cyan_runtime_join(handle.raw);
    handle.raw = ptr.null<void>();
}

impl drop(&mut JoinHandle self) {
    if (self.raw == ptr.null<void>()) {
        return;
    }
    cyan_runtime_detach(self.raw);
    self.raw = ptr.null<void>();
}
