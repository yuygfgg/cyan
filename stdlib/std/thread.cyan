extern {
    i32 cyan_runtime_parallel_do(const void* tasks, i64 count);
}

export interface<T> void run_task(&T task);
export interface thread_shared = share - local;
export interface thread_sendable = send - local;
export interface threaded_runnable = run_task + thread_shared;

export void parallel_do([]&threaded_runnable tasks) {
    i64 count = len(tasks);
    if (count <= 0) {
        return;
    }
    if (count == 1) {
        run_task(tasks[0]);
        return;
    }
    unchecked {
        cyan_runtime_parallel_do(raw_data(tasks), count);
    }
}
