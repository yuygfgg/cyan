extern {
    i32 cyan_runtime_parallel_do(const void* tasks, i64 count);
}

export interface<T> void run_task(&T task);

export void parallel_do([]&run_task tasks) {
    i64 count = len(tasks);
    if (count <= 0) {
        return;
    }
    if (count == 1) {
        run_task(tasks[0]);
        return;
    }
    unchecked {
        cyan_runtime_parallel_do(raw_data(tasks), count);
    }
}
