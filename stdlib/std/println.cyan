import /std.cstr as cstr;
import /std.err;
import /std.error;
import /std.file as file;
import /std.fmt;
import /std.result;
import /std.view;

extern {
    i32 dup(i32 fd);
    i32 close(i32 fd);
}

export enum PrintError {
    PrintFmtFailed(FmtError),
    PrintFileFailed(file.FileError),
    PrintShortWrite,
};

PrintError print_from_file(file.FileError error) {
    return PrintFileFailed(error);
}

PrintError print_from_fmt(FmtError error) {
    return PrintFmtFailed(error);
}

Result<Unit, PrintError> write_stream(void* stream, &StringBuilder out) {
    i64 written;
    switch (move file.fwrite(out.ptr, 1, out.len, stream)) {
        case Ok(count):
            written = count;
        case Err(error):
            return Err(print_from_file(error));
    }
    if (written != out.len) {
        return Err(PrintShortWrite());
    }
    return Ok(Unit());
}

Result<Unit, PrintError> write_fd(i32 fd, &StringBuilder out) {
    i32 duplicated_fd = dup(fd);

    void* stream;
    switch (move file.fdopen(duplicated_fd, "w")) {
        case Ok(handle):
            stream = handle;
        case Err(error):
            if (duplicated_fd >= 0) {
                close(duplicated_fd);
            }
            return Err(print_from_file(error));
    }

    Result<Unit, PrintError> write_result = write_stream(stream, out);

    Result<Unit, PrintError> close_result;
    switch (move file.fclose(stream)) {
        case Ok(_):
            close_result = Ok(Unit());
        case Err(error):
            close_result = Err(print_from_file(error));
    }

    bool had_write_error = false;
    PrintError write_error = PrintShortWrite();
    switch (move write_result) {
        case Ok(_):
            had_write_error = false;
        case Err(error):
            had_write_error = true;
            write_error = error;
    }

    switch (move close_result) {
        case Ok(_):
            if (had_write_error) {
                return Err(write_error);
            }
            return Ok(Unit());
        case Err(error):
            if (had_write_error) {
                return Err(write_error);
            }
            return Err(error);
    }
}

export Result<Unit, PrintError> try_fprint(void* stream, const char* format_text,
                                           []&fmt args) {
    StringBuilder out;
    switch (move builder_new(64)) {
        case Ok(builder):
            out = builder;
        case Err(error):
            return Err(print_from_fmt(error));
    }
    switch (move render_into(&mut out, format_text, args)) {
        case Ok(_):
        case Err(error):
            return Err(print_from_fmt(error));
    }
    return write_stream(stream, &out);
}

export Result<Unit, PrintError> try_fprintln(void* stream,
                                             const char* format_text,
                                             []&fmt args) {
    StringBuilder out;
    switch (move builder_new(64)) {
        case Ok(builder):
            out = builder;
        case Err(error):
            return Err(print_from_fmt(error));
    }
    switch (move render_into(&mut out, format_text, args)) {
        case Ok(_):
        case Err(error):
            return Err(print_from_fmt(error));
    }
    switch (move fmt_write_char(&mut out, '\n')) {
        case Ok(_):
        case Err(error):
            return Err(print_from_fmt(error));
    }
    return write_stream(stream, &out);
}

export Result<Unit, PrintError> try_print(const char* format_text,
                                          []&fmt args) {
    StringBuilder out;
    switch (move builder_new(64)) {
        case Ok(builder):
            out = builder;
        case Err(error):
            return Err(print_from_fmt(error));
    }
    switch (move render_into(&mut out, format_text, args)) {
        case Ok(_):
        case Err(error):
            return Err(print_from_fmt(error));
    }
    return write_fd(1, &out);
}

export Result<Unit, PrintError> try_println(const char* format_text,
                                            []&fmt args) {
    StringBuilder out;
    switch (move builder_new(64)) {
        case Ok(builder):
            out = builder;
        case Err(error):
            return Err(print_from_fmt(error));
    }
    switch (move render_into(&mut out, format_text, args)) {
        case Ok(_):
        case Err(error):
            return Err(print_from_fmt(error));
    }
    switch (move fmt_write_char(&mut out, '\n')) {
        case Ok(_):
        case Err(error):
            return Err(print_from_fmt(error));
    }
    return write_fd(1, &out);
}

export Result<Unit, PrintError> try_fprint0(void* stream,
                                            const char* format_text) {
    []&fmt args = [];
    return try_fprint(stream, format_text, args);
}

export Result<Unit, PrintError> try_fprintln0(void* stream,
                                              const char* format_text) {
    []&fmt args = [];
    return try_fprintln(stream, format_text, args);
}

export Result<Unit, PrintError> try_print0(const char* format_text) {
    []&fmt args = [];
    return try_print(format_text, args);
}

export Result<Unit, PrintError> try_println0(const char* format_text) {
    []&fmt args = [];
    return try_println(format_text, args);
}

export void fprint(void* stream, const char* format_text, []&fmt args) {
    must(try_fprint(stream, format_text, args));
}

export void fprintln(void* stream, const char* format_text, []&fmt args) {
    must(try_fprintln(stream, format_text, args));
}

export void print(const char* format_text, []&fmt args) {
    must(try_print(format_text, args));
}

export void println(const char* format_text, []&fmt args) {
    must(try_println(format_text, args));
}

export void fprint0(void* stream, const char* format_text) {
    must(try_fprint0(stream, format_text));
}

export void fprintln0(void* stream, const char* format_text) {
    must(try_fprintln0(stream, format_text));
}

export void print0(const char* format_text) {
    must(try_print0(format_text));
}

export void println0(const char* format_text) {
    must(try_println0(format_text));
}

impl err(&PrintError value) {}

impl fmt(&PrintError value, &mut StringBuilder out) {
    PrintError copy = *value;
    switch (move copy) {
        case PrintFmtFailed(error):
            fmt_write_cstr(out, "print formatting failed")?;
            fmt_write_cstr(out, ": ")?;
            return fmt(error, out);
        case PrintFileFailed(error):
            fmt_write_cstr(out, "print file failed")?;
            fmt_write_cstr(out, ": ")?;
            return fmt(error, out);
        case PrintShortWrite:
            return fmt_write_cstr(out, "print short write");
    }
}
