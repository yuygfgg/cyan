import /std.ryu as ryu;
import /std.ptr as ptr;

extern {
    i64 strtoll(const char* text, void* endptr, i32 base);
    u64 strtoull(const char* text, void* endptr, i32 base);
    f64 strtod(const char* text, void* endptr);
}

void buffer_push_char(char* out, &mut i64 len, char value) {
    unchecked {
        out[*len] = value;
        *len = *len + 1;
        out[*len] = '\0';
    }
}

void buffer_push_digit(char* out, &mut i64 len, i64 digit) {
    i64 ascii = ('0' as i64) + digit;
    buffer_push_char(out, &mut len, ascii as char);
}

void buffer_append_positive_i64(char* out, &mut i64 len, i64 value) {
    if (value >= 10) {
        buffer_append_positive_i64(out, &mut len, value / 10);
    }
    buffer_push_digit(out, &mut len, value % 10);
}

void buffer_append_negative_i64_digits(char* out, &mut i64 len, i64 value) {
    if (value <= -10) {
        buffer_append_negative_i64_digits(out, &mut len, value / 10);
    }
    buffer_push_digit(out, &mut len, 0 - (value % 10));
}

void buffer_append_u64_digits(char* out, &mut i64 len, u64 value) {
    if (value >= (10 as u64)) {
        buffer_append_u64_digits(out, &mut len, value / (10 as u64));
    }
    buffer_push_digit(out, &mut len, (value % (10 as u64)) as i64);
}

void buffer_append_positive_i128(char* out, &mut i64 len, i128 value) {
    if (value >= (10 as i128)) {
        buffer_append_positive_i128(out, &mut len, value / (10 as i128));
    }
    buffer_push_digit(out, &mut len, (value % (10 as i128)) as i64);
}

void buffer_append_negative_i128_digits(char* out, &mut i64 len, i128 value) {
    if (value <= (-10 as i128)) {
        buffer_append_negative_i128_digits(out, &mut len, value / (10 as i128));
    }
    buffer_push_digit(out, &mut len, (0 as i64) - ((value % (10 as i128)) as i64));
}

void buffer_append_u128_digits(char* out, &mut i64 len, u128 value) {
    if (value >= (10 as u128)) {
        buffer_append_u128_digits(out, &mut len, value / (10 as u128));
    }
    buffer_push_digit(out, &mut len, (value % (10 as u128)) as i64);
}

bool is_ascii_space(char value) {
    return value == ' ' || value == '\t' || value == '\n' || value == '\r' ||
        value == '\v' || value == '\f';
}

bool is_decimal_digit(char value) {
    return value as i32 >= '0' as i32 && value as i32 <= '9' as i32;
}

i32 decimal_digit_value(char value) {
    return (value as i32) - ('0' as i32);
}

export i64 write_i64(char* out, i64 value) {
    i64 len = 0;
    unchecked {
        out[0] = '\0';
    }

    if (value < 0) {
        buffer_push_char(out, &mut len, '-');
        buffer_append_negative_i64_digits(out, &mut len, value);
        return len;
    }

    buffer_append_positive_i64(out, &mut len, value);
    return len;
}

export i64 write_u64(char* out, u64 value) {
    i64 len = 0;
    unchecked {
        out[0] = '\0';
    }
    buffer_append_u64_digits(out, &mut len, value);
    return len;
}

export i64 write_i128(char* out, i128 value) {
    i64 len = 0;
    unchecked {
        out[0] = '\0';
    }

    if (value < (0 as i128)) {
        buffer_push_char(out, &mut len, '-');
        buffer_append_negative_i128_digits(out, &mut len, value);
        return len;
    }

    buffer_append_positive_i128(out, &mut len, value);
    return len;
}

export i64 write_u128(char* out, u128 value) {
    i64 len = 0;
    unchecked {
        out[0] = '\0';
    }
    buffer_append_u128_digits(out, &mut len, value);
    return len;
}

export i64 write_f64(char* out, i64 capacity, f64 value) {
    return ryu.write_f64(out, capacity, value);
}

export i64 write_f32(char* out, i64 capacity, f32 value) {
    return ryu.write_f32(out, capacity, value);
}

export i64 parse_i64(const char* text) {
    return strtoll(text, ptr.null<void>(), 10);
}

export u64 parse_u64(const char* text) {
    return strtoull(text, ptr.null<void>(), 10);
}

export i128 parse_i128(const char* text) {
    const char* cursor = text;
    unchecked {
        while (*cursor != '\0' && is_ascii_space(*cursor)) {
            cursor = cursor + 1;
        }
    }

    bool negative = false;
    unchecked {
        if (*cursor == '+') {
            cursor = cursor + 1;
        } else {
            if (*cursor == '-') {
                negative = true;
                cursor = cursor + 1;
            }
        }
    }

    i128 min_i128 = -170141183460469231731687303715884105728;
    i128 max_i128 = 170141183460469231731687303715884105727;

    if (negative) {
        i128 value = 0 as i128;
        bool saw_digit = false;
        unchecked {
            while (is_decimal_digit(*cursor)) {
                saw_digit = true;
                i128 digit = decimal_digit_value(*cursor) as i128;
                if (value < (min_i128 + digit) / (10 as i128)) {
                    return min_i128;
                }
                value = value * (10 as i128) - digit;
                cursor = cursor + 1;
            }
        }
        if (!saw_digit) {
            return 0 as i128;
        }
        return value;
    }

    i128 value = 0 as i128;
    bool saw_digit = false;
    unchecked {
        while (is_decimal_digit(*cursor)) {
            saw_digit = true;
            i128 digit = decimal_digit_value(*cursor) as i128;
            if (value > (max_i128 - digit) / (10 as i128)) {
                return max_i128;
            }
            value = value * (10 as i128) + digit;
            cursor = cursor + 1;
        }
    }

    if (!saw_digit) {
        return 0 as i128;
    }
    return value;
}

export u128 parse_u128(const char* text) {
    const char* cursor = text;
    unchecked {
        while (*cursor != '\0' && is_ascii_space(*cursor)) {
            cursor = cursor + 1;
        }
    }

    bool negative = false;
    unchecked {
        if (*cursor == '+') {
            cursor = cursor + 1;
        } else {
            if (*cursor == '-') {
                negative = true;
                cursor = cursor + 1;
            }
        }
    }

    u128 max_u128 = 340282366920938463463374607431768211455 as u128;
    u128 value = 0 as u128;
    bool saw_digit = false;
    unchecked {
        while (is_decimal_digit(*cursor)) {
            saw_digit = true;
            u128 digit = decimal_digit_value(*cursor) as u128;
            if (value > (max_u128 - digit) / (10 as u128)) {
                value = max_u128;
                while (is_decimal_digit(*cursor)) {
                    cursor = cursor + 1;
                }
                break;
            }
            value = value * (10 as u128) + digit;
            cursor = cursor + 1;
        }
    }

    if (!saw_digit) {
        return 0 as u128;
    }
    if (negative) {
        return (0 as u128) - value;
    }
    return value;
}

export f64 parse_f64(const char* text) {
    return strtod(text, ptr.null<void>());
}

export f32 parse_f32(const char* text) {
    return parse_f64(text) as f32;
}
