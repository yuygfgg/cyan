import /std.atomic;
import /std.heap as heap;
import /std.result;

export struct Arc<T> {
    shared i64* strong;
    shared T* data;
};

export Result<Arc<T>, heap.AllocError> arc_new<T>(T value) {
    i64* raw_strong = heap.malloc_array<i64>(1)?;
    T* raw_data;
    switch (move heap.malloc_array<T>(1)) {
        case Ok(memory):
            raw_data = memory;
        case Err(error):
            heap.free_ptr(raw_strong);
            return Err(error);
    }

    shared i64* strong;
    shared T* data;
    unchecked {
        *raw_strong = 1;
        *raw_data = value;
        strong = raw_strong as shared i64*;
        data = raw_data as shared T*;
    }
    return Ok({strong, data});
}

export Arc<T> arc_clone<T>(&Arc<T> arc) {
    atomic_fetch_add(arc.strong, 1, atomic_relaxed());
    return {arc.strong, arc.data};
}

export &T arc_get<T>(&Arc<T> arc) depends(return on arc) {
    unchecked {
        return arc.data as &T on arc;
    }
}

impl drop<T>(&mut Arc<T> self) {
    i64 previous = atomic_fetch_sub(self.strong, 1, atomic_release());
    if (previous != 1) {
        return;
    }
    atomic_fence(atomic_acquire());
    unchecked {
        drop(self.data as &mut T on self);
        heap.free_ptr(self.data as T*);
        heap.free_ptr(self.strong as i64*);
    }
}

export struct Mutex<T> {
    shared i64* locked;
    shared T* data;
};

export struct MutexGuard<T> {
    shared i64* locked;
    &mut T data;
};

export Result<Mutex<T>, heap.AllocError> mutex_new<T>(T value) {
    i64* raw_locked = heap.malloc_array<i64>(1)?;
    T* raw_data;
    switch (move heap.malloc_array<T>(1)) {
        case Ok(memory):
            raw_data = memory;
        case Err(error):
            heap.free_ptr(raw_locked);
            return Err(error);
    }

    shared i64* locked;
    shared T* data;
    unchecked {
        *raw_locked = 0;
        *raw_data = value;
        locked = raw_locked as shared i64*;
        data = raw_data as shared T*;
    }
    return Ok({locked, data});
}

export MutexGuard<T> lock<T>(&Mutex<T> mutex)
    depends(return.data on mutex) {
    while (atomic_compare_exchange(
               mutex.locked, 0, 1, atomic_acquire(), atomic_acquire()) != 0) {
    }

    unchecked {
        return {mutex.locked, mutex.data as &mut T on mutex};
    }
}

impl drop<T>(&mut MutexGuard<T> self) {
    atomic_store(self.locked, 0, atomic_release());
}

impl drop<T>(&mut Mutex<T> self) {
    unchecked {
        drop(self.data as &mut T on self);
        heap.free_ptr(self.data as T*);
        heap.free_ptr(self.locked as i64*);
    }
}
