import /std.heap as heap;
import /std.result;

export struct Rc<T> {
    i64* strong;
    T* data;
};

impl local<T>(Rc<T>);

export Result<Rc<T>, heap.AllocError> rc_new<T>(T value) {
    i64* strong = heap.malloc_array<i64>(1)?;
    T* data;
    switch (move heap.malloc_array<T>(1)) {
        case Ok(memory):
            data = memory;
        case Err(error):
            heap.free_ptr(strong);
            return Err(error);
    }

    unchecked {
        *strong = 1;
        *data = value;
    }
    return Ok({strong, data});
}

export Rc<T> rc_clone<T>(&Rc<T> rc) {
    unchecked {
        *rc.strong = *rc.strong + 1;
    }
    return {rc.strong, rc.data};
}

export &T rc_get<T>(&Rc<T> rc) depends(return on rc) {
    unchecked {
        return rc.data as &T on rc;
    }
}

impl drop<T>(&mut Rc<T> self) {
    unchecked {
        *self.strong = *self.strong - 1;
        if (*self.strong == 0) {
            drop(self.data as &mut T on self);
            heap.free_ptr(self.data);
            heap.free_ptr(self.strong);
        }
    }
}
