import /std.mem as mem;
import /std.ptr as ptr;

// Ryu shortest-roundtrip float formatting adapted to Cyan.
// Table values follow the reference implementation from ulfjack/ryu.

struct U64Pair {
    u64 low;
    u64 high;
};

struct FloatingDecimal64 {
    u64 mantissa;
    i32 exponent;
};

struct FloatingDecimal32 {
    u32 mantissa;
    i32 exponent;
};

i32 pow5bits(i32 e) {
    return ((((e as u32) * (1217359 as u32)) >> 19) as i32) + 1;
}

u32 log10_pow2(i32 e) {
    return ((e as u32) * (78913 as u32)) >> 18;
}

u32 log10_pow5(i32 e) {
    return ((e as u32) * (732923 as u32)) >> 20;
}

u64 f64_to_bits(f64 value) {
    u64 bits = 0 as u64;
    u64* dst = &mut bits;
    const f64* src = &value;
    unchecked {
        mem.memcpy(dst as char*, src as const char*, sizeof(u64));
    }
    return bits;
}

u32 f32_to_bits(f32 value) {
    u32 bits = 0 as u32;
    u32* dst = &mut bits;
    const f32* src = &value;
    unchecked {
        mem.memcpy(dst as char*, src as const char*, sizeof(u32));
    }
    return bits;
}

bool checked_push_char(char* out, i64 capacity, &mut i64 len, char value) {
    if (*len + 1 >= capacity) {
        return false;
    }

    unchecked {
        out[*len] = value;
        *len = *len + 1;
        out[*len] = '\0';
    }
    return true;
}

bool checked_push_digit(char* out, i64 capacity, &mut i64 len, i64 digit) {
    return checked_push_char(out, capacity, &mut len, (('0' as i64) + digit) as char);
}

bool checked_append_literal(char* out, i64 capacity, &mut i64 len, const char* text) {
    unchecked {
        const char* cursor = text;
        while (*cursor != '\0') {
            if (!checked_push_char(out, capacity, &mut len, *cursor)) {
                return false;
            }
            cursor = cursor + 1;
        }
    }
    return true;
}

bool checked_append_u64_digits(char* out, i64 capacity, &mut i64 len, u64 value) {
    if (value >= (10 as u64)) {
        if (!checked_append_u64_digits(out, capacity, &mut len, value / (10 as u64))) {
            return false;
        }
    }
    return checked_push_digit(out, capacity, &mut len, (value % (10 as u64)) as i64);
}

u64 pow10_u64(i64 exp) {
    u64 result = 1 as u64;
    i64 i = 0;
    while (i < exp) {
        result = result * (10 as u64);
        i++;
    }
    return result;
}

bool checked_append_u64_zero_padded(char* out, i64 capacity, &mut i64 len, u64 value, i64 width) {
    if (width <= 0) {
        return true;
    }

    u64 divisor = pow10_u64(width - 1);
    i64 written = 0;
    u64 remaining = value;
    while (written < width) {
        u64 digit = remaining / divisor;
        if (!checked_push_digit(out, capacity, &mut len, digit as i64)) {
            return false;
        }

        remaining = remaining % divisor;
        if (divisor > (1 as u64)) {
            divisor = divisor / (10 as u64);
        }
        written++;
    }
    return true;
}

u32 decimal_length_u64(u64 value) {
    if (value >= 10000000000000000 as u64) {
        return 17 as u32;
    }
    if (value >= 1000000000000000 as u64) {
        return 16 as u32;
    }
    if (value >= 100000000000000 as u64) {
        return 15 as u32;
    }
    if (value >= 10000000000000 as u64) {
        return 14 as u32;
    }
    if (value >= 1000000000000 as u64) {
        return 13 as u32;
    }
    if (value >= 100000000000 as u64) {
        return 12 as u32;
    }
    if (value >= 10000000000 as u64) {
        return 11 as u32;
    }
    if (value >= 1000000000 as u64) {
        return 10 as u32;
    }
    if (value >= 100000000 as u64) {
        return 9 as u32;
    }
    if (value >= 10000000 as u64) {
        return 8 as u32;
    }
    if (value >= 1000000 as u64) {
        return 7 as u32;
    }
    if (value >= 100000 as u64) {
        return 6 as u32;
    }
    if (value >= 10000 as u64) {
        return 5 as u32;
    }
    if (value >= 1000 as u64) {
        return 4 as u32;
    }
    if (value >= 100 as u64) {
        return 3 as u32;
    }
    if (value >= 10 as u64) {
        return 2 as u32;
    }
    return 1 as u32;
}

void zero_terminate(char* out, i64 capacity) {
    if (capacity <= 0) {
        return;
    }
    unchecked {
        out[0] = '\0';
    }
}

u32 pow5_factor_32(u32 value) {
    u32 count = 0 as u32;
    u32 current = value;
    while (true) {
        u32 q = current / (5 as u32);
        u32 r = current % (5 as u32);
        if (r != (0 as u32)) {
            return count;
        }
        current = q;
        count = count + (1 as u32);
    }
    return count;
}

u32 pow5_factor_64(u64 value) {
    u32 count = 0 as u32;
    u64 current = value;
    while (true) {
        u64 q = current / (5 as u64);
        u64 r = current % (5 as u64);
        if (r != (0 as u64)) {
            return count;
        }
        current = q;
        count = count + (1 as u32);
    }
    return count;
}

bool multiple_of_power_of_5_32(u32 value, u32 p) {
    return pow5_factor_32(value) >= p;
}

bool multiple_of_power_of_5_64(u64 value, u32 p) {
    return pow5_factor_64(value) >= p;
}

bool multiple_of_power_of_2_32(u32 value, u32 p) {
    if (p == (0 as u32)) {
        return true;
    }
    return (value & (((1 as u32) << p) - (1 as u32))) == (0 as u32);
}

bool multiple_of_power_of_2_64(u64 value, u32 p) {
    if (p == (0 as u32)) {
        return true;
    }
    return (value & (((1 as u64) << p) - (1 as u64))) == (0 as u64);
}

