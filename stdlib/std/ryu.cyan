U64Pair double_compute_pow5(u32 i) {
    u32 base = i / (26 as u32);
    u32 base2 = base * (26 as u32);
    u32 offset = i - base2;
    U64Pair mul = double_pow5_split2(base);
    if (offset == (0 as u32)) {
        return mul;
    }

    u64 m = double_pow5_table(offset);
    u128 b0 = (m as u128) * (mul.low as u128);
    u128 b2 = (m as u128) * (mul.high as u128);
    i32 delta = pow5bits(i as i32) - pow5bits(base2 as i32);
    u32 offset_bits = (pow5_offset(i / (16 as u32)) >> ((i % (16 as u32)) * (2 as u32))) & (3 as u32);
    u128 shifted = (b0 >> delta) + (b2 << (64 - delta)) + (offset_bits as u128);
    return {shifted as u64, (shifted >> 64) as u64};
}

U64Pair double_compute_inv_pow5(u32 i) {
    u32 base = (i + (25 as u32)) / (26 as u32);
    u32 base2 = base * (26 as u32);
    u32 offset = base2 - i;
    U64Pair mul = double_pow5_inv_split2(base);
    if (offset == (0 as u32)) {
        return mul;
    }

    u64 m = double_pow5_table(offset);
    u128 b0 = (m as u128) * ((mul.low - (1 as u64)) as u128);
    u128 b2 = (m as u128) * (mul.high as u128);
    i32 delta = pow5bits(base2 as i32) - pow5bits(i as i32);
    u32 offset_bits = (pow5_inv_offset(i / (16 as u32)) >> ((i % (16 as u32)) * (2 as u32))) & (3 as u32);
    u128 shifted = (b0 >> delta) + (b2 << (64 - delta)) + (1 as u128) + (offset_bits as u128);
    return {shifted as u64, (shifted >> 64) as u64};
}

u64 mul_shift64(u64 m, U64Pair mul, i32 j) {
    u128 b0 = (m as u128) * (mul.low as u128);
    u128 b2 = (m as u128) * (mul.high as u128);
    return ((((b0 >> 64) + b2) >> (j - 64)) as u64);
}

u64 mul_shift_all64(u64 m, U64Pair mul, i32 j, &mut u64 vp, &mut u64 vm, u32 mm_shift) {
    *vp = mul_shift64(m * (4 as u64) + (2 as u64), mul, j);
    *vm = mul_shift64(m * (4 as u64) - (1 as u64) - (mm_shift as u64), mul, j);
    return mul_shift64(m * (4 as u64), mul, j);
}

u32 mul_shift32(u32 m, u64 factor, i32 shift) {
    u128 product = (m as u128) * (factor as u128);
    return (product >> shift) as u32;
}

u32 mul_pow5_inv_div_pow2(u32 m, u32 q, i32 j) {
    U64Pair mul = double_compute_inv_pow5(q);
    return mul_shift32(m, mul.high + (1 as u64), j);
}

u32 mul_pow5_div_pow2(u32 m, u32 i, i32 j) {
    U64Pair mul = double_compute_pow5(i);
    return mul_shift32(m, mul.high, j);
}

bool d2d_small_int(u64 ieee_mantissa, u32 ieee_exponent, &mut FloatingDecimal64 out) {
    u64 m2 = ((1 as u64) << 52) | ieee_mantissa;
    i32 e2 = (ieee_exponent as i32) - 1023 - 52;

    if (e2 > 0 || e2 < -52) {
        return false;
    }

    u64 mask = (((1 as u64) << (0 - e2)) - (1 as u64));
    if ((m2 & mask) != (0 as u64)) {
        return false;
    }

    out.mantissa = m2 >> (0 - e2);
    out.exponent = 0;
    return true;
}

FloatingDecimal64 d2d(u64 ieee_mantissa, u32 ieee_exponent) {
    i32 e2 = 0;
    u64 m2 = 0 as u64;
    if (ieee_exponent == (0 as u32)) {
        e2 = 1 - 1023 - 52 - 2;
        m2 = ieee_mantissa;
    } else {
        e2 = (ieee_exponent as i32) - 1023 - 52 - 2;
        m2 = ((1 as u64) << 52) | ieee_mantissa;
    }

    bool even = (m2 & (1 as u64)) == (0 as u64);
    bool accept_bounds = even;
    u64 mv = (4 as u64) * m2;
    u32 mm_shift = 0 as u32;
    if (ieee_mantissa != (0 as u64) || ieee_exponent <= (1 as u32)) {
        mm_shift = 1 as u32;
    }

    u64 vr = 0 as u64;
    u64 vp = 0 as u64;
    u64 vm = 0 as u64;
    i32 e10 = 0;
    bool vm_is_trailing_zeros = false;
    bool vr_is_trailing_zeros = false;

    if (e2 >= 0) {
        u32 q = log10_pow2(e2);
        if (e2 > 3) {
            q = q - (1 as u32);
        }
        e10 = q as i32;
        i32 k = 125 + pow5bits(q as i32) - 1;
        i32 i = 0 - e2 + (q as i32) + k;
        U64Pair pow5 = double_compute_inv_pow5(q);
        vr = mul_shift_all64(m2, pow5, i, &mut vp, &mut vm, mm_shift);

        if (q <= (21 as u32)) {
            u64 mv_mod5 = mv % (5 as u64);
            if (mv_mod5 == (0 as u64)) {
                vr_is_trailing_zeros = multiple_of_power_of_5_64(mv, q);
            } else {
                if (accept_bounds) {
                    vm_is_trailing_zeros = multiple_of_power_of_5_64(mv - (1 as u64) - (mm_shift as u64), q);
                } else {
                    if (multiple_of_power_of_5_64(mv + (2 as u64), q)) {
                        vp = vp - (1 as u64);
                    }
                }
            }
        }
    } else {
        u32 q = log10_pow5(0 - e2);
        if ((0 - e2) > 1) {
            q = q - (1 as u32);
        }
        e10 = (q as i32) + e2;
        i32 i = (0 - e2) - (q as i32);
        i32 k = pow5bits(i) - 125;
        i32 j = (q as i32) - k;
        U64Pair pow5 = double_compute_pow5(i as u32);
        vr = mul_shift_all64(m2, pow5, j, &mut vp, &mut vm, mm_shift);

        if (q <= (1 as u32)) {
            vr_is_trailing_zeros = true;
            if (accept_bounds) {
                vm_is_trailing_zeros = mm_shift == (1 as u32);
            } else {
                vp = vp - (1 as u64);
            }
        } else {
            if (q < (63 as u32)) {
                vr_is_trailing_zeros = multiple_of_power_of_2_64(mv, q);
            }
        }
    }

    i32 removed = 0;
    u32 last_removed_digit = 0 as u32;
    u64 output = 0 as u64;

    if (vm_is_trailing_zeros || vr_is_trailing_zeros) {
        while (true) {
            u64 vp_div10 = vp / (10 as u64);
            u64 vm_div10 = vm / (10 as u64);
            if (vp_div10 <= vm_div10) {
                break;
            }

            u32 vm_mod10 = (vm % (10 as u64)) as u32;
            u64 vr_div10 = vr / (10 as u64);
            u32 vr_mod10 = (vr % (10 as u64)) as u32;

            if (vm_mod10 != (0 as u32)) {
                vm_is_trailing_zeros = false;
            }
            if (last_removed_digit != (0 as u32)) {
                vr_is_trailing_zeros = false;
            }

            last_removed_digit = vr_mod10;
            vr = vr_div10;
            vp = vp_div10;
            vm = vm_div10;
            removed++;
        }

        if (vm_is_trailing_zeros) {
            while (true) {
                u64 vm_div10 = vm / (10 as u64);
                u32 vm_mod10 = (vm % (10 as u64)) as u32;
                if (vm_mod10 != (0 as u32)) {
                    break;
                }

                u64 vp_div10 = vp / (10 as u64);
                u64 vr_div10 = vr / (10 as u64);
                u32 vr_mod10 = (vr % (10 as u64)) as u32;

                if (last_removed_digit != (0 as u32)) {
                    vr_is_trailing_zeros = false;
                }

                last_removed_digit = vr_mod10;
                vr = vr_div10;
                vp = vp_div10;
                vm = vm_div10;
                removed++;
            }
        }

        if (vr_is_trailing_zeros && last_removed_digit == (5 as u32) && (vr % (2 as u64)) == (0 as u64)) {
            last_removed_digit = 4 as u32;
        }

        output = vr;
        if ((vr == vm && (!accept_bounds || !vm_is_trailing_zeros)) || last_removed_digit >= (5 as u32)) {
            output = output + (1 as u64);
        }
    } else {
        bool round_up = false;
        u64 vp_div100 = vp / (100 as u64);
        u64 vm_div100 = vm / (100 as u64);
        if (vp_div100 > vm_div100) {
            u64 vr_div100 = vr / (100 as u64);
            u32 vr_mod100 = (vr % (100 as u64)) as u32;
            round_up = vr_mod100 >= (50 as u32);
            vr = vr_div100;
            vp = vp_div100;
            vm = vm_div100;
            removed = removed + 2;
        }

        while (true) {
            u64 vp_div10 = vp / (10 as u64);
            u64 vm_div10 = vm / (10 as u64);
            if (vp_div10 <= vm_div10) {
                break;
            }

            u64 vr_div10 = vr / (10 as u64);
            u32 vr_mod10 = (vr % (10 as u64)) as u32;
            round_up = vr_mod10 >= (5 as u32);
            vr = vr_div10;
            vp = vp_div10;
            vm = vm_div10;
            removed++;
        }

        output = vr;
        if (vr == vm || round_up) {
            output = output + (1 as u64);
        }
    }

    return {output, e10 + removed};
}

FloatingDecimal32 f2d(u32 ieee_mantissa, u32 ieee_exponent) {
    i32 e2 = 0;
    u32 m2 = 0 as u32;
    if (ieee_exponent == (0 as u32)) {
        e2 = 1 - 127 - 23 - 2;
        m2 = ieee_mantissa;
    } else {
        e2 = (ieee_exponent as i32) - 127 - 23 - 2;
        m2 = ((1 as u32) << 23) | ieee_mantissa;
    }

    bool even = (m2 & (1 as u32)) == (0 as u32);
    bool accept_bounds = even;
    u32 mv = (4 as u32) * m2;
    u32 mp = (4 as u32) * m2 + (2 as u32);
    u32 mm_shift = 0 as u32;
    if (ieee_mantissa != (0 as u32) || ieee_exponent <= (1 as u32)) {
        mm_shift = 1 as u32;
    }
    u32 mm = (4 as u32) * m2 - (1 as u32) - mm_shift;

    u32 vr = 0 as u32;
    u32 vp = 0 as u32;
    u32 vm = 0 as u32;
    i32 e10 = 0;
    bool vm_is_trailing_zeros = false;
    bool vr_is_trailing_zeros = false;
    u32 last_removed_digit = 0 as u32;

    if (e2 >= 0) {
        u32 q = log10_pow2(e2);
        e10 = q as i32;
        i32 k = 61 + pow5bits(q as i32) - 1;
        i32 i = 0 - e2 + (q as i32) + k;
        vr = mul_pow5_inv_div_pow2(mv, q, i);
        vp = mul_pow5_inv_div_pow2(mp, q, i);
        vm = mul_pow5_inv_div_pow2(mm, q, i);

        if (q != (0 as u32) && ((vp - (1 as u32)) / (10 as u32)) <= (vm / (10 as u32))) {
            i32 l = 61 + pow5bits((q - (1 as u32)) as i32) - 1;
            last_removed_digit = mul_pow5_inv_div_pow2(
                mv,
                q - (1 as u32),
                0 - e2 + (q as i32) - 1 + l
            ) % (10 as u32);
        }

        if (q <= (9 as u32)) {
            if ((mv % (5 as u32)) == (0 as u32)) {
                vr_is_trailing_zeros = multiple_of_power_of_5_32(mv, q);
            } else {
                if (accept_bounds) {
                    vm_is_trailing_zeros = multiple_of_power_of_5_32(mm, q);
                } else {
                    if (multiple_of_power_of_5_32(mp, q)) {
                        vp = vp - (1 as u32);
                    }
                }
            }
        }
    } else {
        u32 q = log10_pow5(0 - e2);
        e10 = (q as i32) + e2;
        i32 i = (0 - e2) - (q as i32);
        i32 k = pow5bits(i) - 61;
        i32 j = (q as i32) - k;
        vr = mul_pow5_div_pow2(mv, i as u32, j);
        vp = mul_pow5_div_pow2(mp, i as u32, j);
        vm = mul_pow5_div_pow2(mm, i as u32, j);

        if (q != (0 as u32) && ((vp - (1 as u32)) / (10 as u32)) <= (vm / (10 as u32))) {
            i32 next_j = (q as i32) - 1 - (pow5bits(i + 1) - 61);
            last_removed_digit = mul_pow5_div_pow2(mv, (i + 1) as u32, next_j) % (10 as u32);
        }

        if (q <= (1 as u32)) {
            vr_is_trailing_zeros = true;
            if (accept_bounds) {
                vm_is_trailing_zeros = mm_shift == (1 as u32);
            } else {
                vp = vp - (1 as u32);
            }
        } else {
            if (q < (31 as u32)) {
                vr_is_trailing_zeros = multiple_of_power_of_2_32(mv, q - (1 as u32));
            }
        }
    }

    i32 removed = 0;
    u32 output = 0 as u32;

    if (vm_is_trailing_zeros || vr_is_trailing_zeros) {
        while ((vp / (10 as u32)) > (vm / (10 as u32))) {
            if ((vm % (10 as u32)) != (0 as u32)) {
                vm_is_trailing_zeros = false;
            }
            if (last_removed_digit != (0 as u32)) {
                vr_is_trailing_zeros = false;
            }

            last_removed_digit = vr % (10 as u32);
            vr = vr / (10 as u32);
            vp = vp / (10 as u32);
            vm = vm / (10 as u32);
            removed++;
        }

        if (vm_is_trailing_zeros) {
            while ((vm % (10 as u32)) == (0 as u32)) {
                if (last_removed_digit != (0 as u32)) {
                    vr_is_trailing_zeros = false;
                }

                last_removed_digit = vr % (10 as u32);
                vr = vr / (10 as u32);
                vp = vp / (10 as u32);
                vm = vm / (10 as u32);
                removed++;
            }
        }

        if (vr_is_trailing_zeros && last_removed_digit == (5 as u32) && (vr % (2 as u32)) == (0 as u32)) {
            last_removed_digit = 4 as u32;
        }

        output = vr;
        if ((vr == vm && (!accept_bounds || !vm_is_trailing_zeros)) || last_removed_digit >= (5 as u32)) {
            output = output + (1 as u32);
        }
    } else {
        while ((vp / (10 as u32)) > (vm / (10 as u32))) {
            last_removed_digit = vr % (10 as u32);
            vr = vr / (10 as u32);
            vp = vp / (10 as u32);
            vm = vm / (10 as u32);
            removed++;
        }

        output = vr;
        if (vr == vm || last_removed_digit >= (5 as u32)) {
            output = output + (1 as u32);
        }
    }

    return {output, e10 + removed};
}

bool append_exponent(char* out, i64 capacity, &mut i64 len, i32 exponent) {
    if (!checked_push_char(out, capacity, &mut len, 'e')) {
        return false;
    }

    i32 abs_exp = exponent;
    if (exponent < 0) {
        if (!checked_push_char(out, capacity, &mut len, '-')) {
            return false;
        }
        abs_exp = 0 - exponent;
    } else {
        if (!checked_push_char(out, capacity, &mut len, '+')) {
            return false;
        }
    }

    if (abs_exp >= 100) {
        if (!checked_push_digit(out, capacity, &mut len, (abs_exp / 100) as i64)) {
            return false;
        }
        if (!checked_push_digit(out, capacity, &mut len, ((abs_exp / 10) % 10) as i64)) {
            return false;
        }
        return checked_push_digit(out, capacity, &mut len, (abs_exp % 10) as i64);
    }

    if (!checked_push_digit(out, capacity, &mut len, (abs_exp / 10) as i64)) {
        return false;
    }
    return checked_push_digit(out, capacity, &mut len, (abs_exp % 10) as i64);
}

bool append_fixed_decimal(char* out, i64 capacity, &mut i64 len, u64 mantissa, i32 exponent) {
    u32 digits = decimal_length_u64(mantissa);
    if (exponent >= 0) {
        if (!checked_append_u64_digits(out, capacity, &mut len, mantissa)) {
            return false;
        }
        i32 i = 0;
        while (i < exponent) {
            if (!checked_push_char(out, capacity, &mut len, '0')) {
                return false;
            }
            i++;
        }
        return true;
    }

    i32 dot_pos = (digits as i32) + exponent;
    if (dot_pos > 0) {
        i64 right_digits = (digits as i64) - (dot_pos as i64);
        u64 divisor = pow10_u64(right_digits);
        u64 left = mantissa / divisor;
        u64 right = mantissa % divisor;
        if (!checked_append_u64_digits(out, capacity, &mut len, left)) {
            return false;
        }
        if (!checked_push_char(out, capacity, &mut len, '.')) {
            return false;
        }
        return checked_append_u64_zero_padded(out, capacity, &mut len, right, right_digits);
    }

    if (!checked_push_char(out, capacity, &mut len, '0')) {
        return false;
    }
    if (!checked_push_char(out, capacity, &mut len, '.')) {
        return false;
    }

    i32 zeroes = 0 - dot_pos;
    i32 i = 0;
    while (i < zeroes) {
        if (!checked_push_char(out, capacity, &mut len, '0')) {
            return false;
        }
        i++;
    }
    return checked_append_u64_digits(out, capacity, &mut len, mantissa);
}

bool append_scientific_decimal(char* out, i64 capacity, &mut i64 len, u64 mantissa, i32 exponent) {
    u32 digits = decimal_length_u64(mantissa);
    if (digits == (1 as u32)) {
        if (!checked_append_u64_digits(out, capacity, &mut len, mantissa)) {
            return false;
        }
    } else {
        i64 tail_digits = (digits as i64) - 1;
        u64 divisor = pow10_u64(tail_digits);
        u64 first = mantissa / divisor;
        u64 rest = mantissa % divisor;
        if (!checked_push_digit(out, capacity, &mut len, first as i64)) {
            return false;
        }
        if (!checked_push_char(out, capacity, &mut len, '.')) {
            return false;
        }
        if (!checked_append_u64_zero_padded(out, capacity, &mut len, rest, tail_digits)) {
            return false;
        }
    }

    i32 scientific_exponent = exponent + (digits as i32) - 1;
    return append_exponent(out, capacity, &mut len, scientific_exponent);
}

i64 format_general(char* out, i64 capacity, bool sign, u64 mantissa, i32 exponent) {
    if (out == ptr.null<char>() || capacity <= 0) {
        return -1;
    }

    i64 len = 0;
    zero_terminate(out, capacity);

    if (sign) {
        if (!checked_push_char(out, capacity, &mut len, '-')) {
            return -1;
        }
    }

    u32 digits = decimal_length_u64(mantissa);
    i32 scientific_exponent = exponent + (digits as i32) - 1;
    bool use_scientific = scientific_exponent < -4 || scientific_exponent >= 6;

    if (use_scientific) {
        if (!append_scientific_decimal(out, capacity, &mut len, mantissa, exponent)) {
            return -1;
        }
        return len;
    }

    if (!append_fixed_decimal(out, capacity, &mut len, mantissa, exponent)) {
        return -1;
    }
    return len;
}

i64 write_special(char* out, i64 capacity, bool sign, bool exponent_all_ones, bool mantissa_nonzero) {
    if (out == ptr.null<char>() || capacity <= 0) {
        return -1;
    }

    i64 len = 0;
    zero_terminate(out, capacity);

    if (mantissa_nonzero) {
        if (!checked_append_literal(out, capacity, &mut len, "nan")) {
            return -1;
        }
        return len;
    }

    if (sign) {
        if (!checked_push_char(out, capacity, &mut len, '-')) {
            return -1;
        }
    }

    if (exponent_all_ones) {
        if (!checked_append_literal(out, capacity, &mut len, "inf")) {
            return -1;
        }
        return len;
    }

    if (!checked_push_char(out, capacity, &mut len, '0')) {
        return -1;
    }
    return len;
}

export i64 write_f64(char* out, i64 capacity, f64 value) {
    u64 bits = f64_to_bits(value);
    bool sign = ((bits >> 63) & (1 as u64)) != (0 as u64);
    u64 ieee_mantissa = bits & (((1 as u64) << 52) - (1 as u64));
    u32 ieee_exponent = ((bits >> 52) & (((1 as u64) << 11) - (1 as u64))) as u32;

    if (ieee_exponent == (((1 as u32) << 11) - (1 as u32)) || (ieee_exponent == (0 as u32) && ieee_mantissa == (0 as u64))) {
        return write_special(out, capacity, sign, ieee_exponent == (((1 as u32) << 11) - (1 as u32)), ieee_mantissa != (0 as u64));
    }

    FloatingDecimal64 fd = {0 as u64, 0};
    if (d2d_small_int(ieee_mantissa, ieee_exponent, &mut fd)) {
        while ((fd.mantissa % (10 as u64)) == (0 as u64)) {
            fd.mantissa = fd.mantissa / (10 as u64);
            fd.exponent++;
        }
    } else {
        fd = d2d(ieee_mantissa, ieee_exponent);
    }

    return format_general(out, capacity, sign, fd.mantissa, fd.exponent);
}

export i64 write_f32(char* out, i64 capacity, f32 value) {
    u32 bits = f32_to_bits(value);
    bool sign = ((bits >> 31) & (1 as u32)) != (0 as u32);
    u32 ieee_mantissa = bits & (((1 as u32) << 23) - (1 as u32));
    u32 ieee_exponent = (bits >> 23) & (((1 as u32) << 8) - (1 as u32));

    if (ieee_exponent == (((1 as u32) << 8) - (1 as u32)) || (ieee_exponent == (0 as u32) && ieee_mantissa == (0 as u32))) {
        return write_special(out, capacity, sign, ieee_exponent == (((1 as u32) << 8) - (1 as u32)), ieee_mantissa != (0 as u32));
    }

    FloatingDecimal32 fd = f2d(ieee_mantissa, ieee_exponent);
    return format_general(out, capacity, sign, fd.mantissa as u64, fd.exponent);
}
