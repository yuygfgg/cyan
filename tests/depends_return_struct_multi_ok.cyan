struct PairRefs {
    &i64 left;
    &i64 right;
};

PairRefs pair_refs(&i64 x, &i64 y)
    depends(return.left on x, return.right on y) {
    return {x, y};
}

i64 read(&i64 value) {
    return *value;
}

i64 main() {
    i64 left = 3;
    i64 right = 7;
    PairRefs refs = pair_refs(&left, &right);
    if (read(refs.left) != 3) {
        return 1;
    }
    if (read(refs.right) != 7) {
        return 2;
    }
    return 0;
}
