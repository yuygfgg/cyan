import /std.sync;
import /std.result;
import /std.error;

struct Token {
    &mut i64 counter;
};

impl drop(&mut Token token) {
    *token.counter = *token.counter + 1;
}

i64 main() {
    i64 count = 0;
    {
        Token token = {&mut count};
        Arc<Token> first = must(arc_new(token));
        Arc<Token> second = arc_clone(&first);
    }
    return count - 1;
}
