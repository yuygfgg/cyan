import /std.cstr as cstr;
import /std.heap as heap;
import /std.mem as mem;
import /std.result;
import /std.error;
import /std.strconv as strconv;

i64 main() {
    char[6] expected_i64 = "-1234";
    char[3] expected_u64 = "42";
    char[4] expected_f64 = "0.1";

    char* int_buf = must(heap.malloc_array<char>(21));
    char* uint_buf = must(heap.malloc_array<char>(21));
    char* float_buf = must(heap.malloc_array<char>(64));

    if (strconv.write_i64(int_buf, -1234) != 5) {
        return 1;
    }
    if (mem.memcmp(int_buf, &expected_i64[0], 6) != 0) {
        return 2;
    }

    if (strconv.write_u64(uint_buf, 42 as u64) != 2) {
        return 3;
    }
    if (mem.memcmp(uint_buf, &expected_u64[0], 3) != 0) {
        return 4;
    }

    if (must(strconv.write_f64(float_buf, 64, 0.1)) != 3) {
        return 5;
    }
    if (mem.memcmp(float_buf, &expected_f64[0], 4) != 0) {
        return 6;
    }

    if (must(strconv.parse_i64("-1234")) != -1234) {
        return 7;
    }
    if (must(strconv.parse_u64("42")) != (42 as u64)) {
        return 8;
    }
    if (must(strconv.parse_f64("0.1")) != 0.1) {
        return 9;
    }
    if (must(strconv.parse_f32("1.5")) != (1.5 as f32)) {
        return 10;
    }

    heap.free_ptr(int_buf);
    heap.free_ptr(uint_buf);
    heap.free_ptr(float_buf);
    return 0;
}
