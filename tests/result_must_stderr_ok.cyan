import /std.result;
import /std.error;
import /std.err;
import /std.fmt;

enum Fail {
    Fail,
};

impl err(&Fail value) {}

impl fmt(&Fail value, &mut StringBuilder out) {
    switch (move *value) {
        case Fail:
            return fmt_write_cstr(out, "fail");
    }
}

i64 main() {
    Result<i64, Fail> value = Err(Fail());
    return must(value);
}
