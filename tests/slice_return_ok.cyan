import /std.view;
i64 sum([]i64 values) {
    i64 i = 0;
    i64 total = 0;
    while (i < len(values)) {
        total = total + values[i];
        i++;
    }
    return total;
}

[]i64 id([]i64 values) {
    return values;
}

[]i64 all(&i64[3] values) {
    return values;
}

i64 main() {
    i64[3] values = [2, 3, 4];
    if (sum(id(values)) != 9) {
        return 1;
    }
    if (sum(all(&values)) != 9) {
        return 1;
    }

    []i64 view = id(all(&values));
    if (view[1] != 3) {
        return 1;
    }
    return 0;
}
