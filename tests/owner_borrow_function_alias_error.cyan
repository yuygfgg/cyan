struct Cell {
    shared i64* ptr;
};

&mut i64 borrow_cell(&Cell c) depends(return on c) {
    unchecked {
        return c.ptr as &mut i64 on c;
    }
}

i64 main() {
    i64 x = 0;
    shared i64* ptr = &mut x;
    Cell cell = {ptr};
    &mut i64 first = borrow_cell(&cell);
    &mut i64 second = borrow_cell(&cell);
    return 0;
}
