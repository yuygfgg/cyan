struct Token {
    i64 value;
};

impl drop(&mut Token token) {
    record_drop();
}

bool again([]Token values, i64 i) {
    return i < 3;
}

extern {
    i64 dropped_count();
    void record_drop();
}

i64 run() {
    i64 i = 0;
    while (again([{1}], i)) {
        i++;
    }
    return 0;
}

i64 main() {
    run();
    return dropped_count();
}
