struct Pair {
    &i64 first;
    &i64 second;
};

i64 read_first(Pair pair) {
    return *pair.first;
}

i64 main() {
    i64 a = 4;
    i64 b = 5;
    i64 c = 7;
    i64 d = 8;
    Pair pair = {&a, &b};
    if (a < c) {
        pair = {&a, &b};
    } else {
        pair = {&c, &d};
    }
    return read_first(pair) - 4;
}
