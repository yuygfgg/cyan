struct RefBox {
    &int value;
};

RefBox rewrite_and_make(&mut RefBox r, &int next)
    depends(return.value on next, r.value on next) {
    r.value = next;
    return {next};
}

RefBox forward(RefBox r, &int next)
    depends(return on r) {
    return rewrite_and_make(&mut r, next);
}

int main() {
    int first = 1;
    int second = 5;
    RefBox box = {&first};
    RefBox out = forward(box, &second);
    return *out.value - 5;
}
