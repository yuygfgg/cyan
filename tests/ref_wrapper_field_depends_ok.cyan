struct Ref<T> {
    &T value;
};

Ref<T> make_ref<T>(&T value) depends(return.value on value) {
    return {value};
}

&T get<T>(&Ref<T> r) depends(return on r.value) {
    return r.value;
}

i64 main() {
    i64 x = 10;
    Ref<i64> wrapped = make_ref(&x);
    &i64 rx = get(&wrapped);
    return *rx - 10;
}
