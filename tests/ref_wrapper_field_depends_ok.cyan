struct Ref<T> {
    &T value;
};

Ref<T> make_ref<T>(&T value) depends(return.value on value) {
    return {value};
}

&T get<T>(&Ref<T> r) depends(return on r.value) {
    return r.value;
}

int main() {
    int x = 10;
    Ref<int> wrapped = make_ref(&x);
    &int rx = get(&wrapped);
    return *rx - 10;
}
