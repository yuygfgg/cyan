void store(&mut i64 out, i64 value) {
    *out = value;
}

interface<T> void fmt(&T value, &mut i64 out);

struct Box {
    i64 value;
};

impl fmt(&Box value, &mut i64 out) {
    store(&mut out, value.value);
}

i64 main() {
    Box box = {7};
    i64 out = 0;
    fmt(box, &mut out);
    return out - 7;
}
