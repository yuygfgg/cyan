import modules.buffer;

extern {
    i64* get_int_buffer();
    f64* get_float_buffer();
}

i64 main() {
    Buffer<i64> ints = {get_int_buffer(), 1};
    Buffer<f64> floats = {get_float_buffer(), 1};
    i64 left = buffer_first(&ints);
    f64 right = buffer_first(&floats);
    if (left == 7 && right == 3.5) {
        return 0;
    }
    return 1;
}
