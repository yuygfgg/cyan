import /std.sync;
import /std.thread;
import /std.result;
import /std.error;

struct AddTask {
    &Mutex<i64> total;
    i64 loops;
};

impl run_task(&AddTask task) {
    i64 i = 0;
    while (i < task.loops) {
        MutexGuard<i64> guard = lock(task.total);
        *guard.data = *guard.data + 1;
        i = i + 1;
    }
}

i64 main() {
    Mutex<i64> total = must(mutex_new(0));

    AddTask first = {&total, 2000};
    AddTask second = {&total, 2000};
    AddTask third = {&total, 2000};
    AddTask fourth = {&total, 2000};
    AddTask fifth = {&total, 2000};
    AddTask sixth = {&total, 2000};

    parallel_do([first, second, third, fourth, fifth, sixth]);

    MutexGuard<i64> guard = lock(&total);
    return *guard.data - 12000;
}
