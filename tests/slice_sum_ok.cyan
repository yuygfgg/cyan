i64 sum([]i64 values) {
    i64 i = 0;
    i64 total = 0;
    while (i < len(values)) {
        total = total + values[i];
        i++;
    }
    return total;
}

i64 main() {
    i64[3] values = [3, 4, 5];
    if (sum(values) != 12) {
        return 1;
    }

    []i64 view = values;
    if (len(view) != 3) {
        return 1;
    }
    if (sum(view) != 12) {
        return 1;
    }
    return 0;
}
