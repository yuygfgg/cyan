struct Box {
    i64 value;
};

struct OneBox {
    Box* ptr;
};

impl drop(&mut Box value) {
    record_drop();
    return;
}

impl drop(&mut OneBox boxes) {
    unchecked {
        drop(boxes.ptr[0]);
    }
}

extern {
    Box* get_box_buffer();
    i64 dropped_count();
    void record_drop();
}

i64 compute() {
    OneBox boxes = {get_box_buffer()};
    return 0;
}

i64 main() {
    compute();
    return dropped_count();
}
