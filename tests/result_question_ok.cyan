import /std.result;
import /std.error;
import /std.err;
import /std.fmt;

enum ParseError {
    ParseFailed,
};

impl err(&ParseError value) {}

impl fmt(&ParseError value, &mut StringBuilder out) {
    switch (move *value) {
        case ParseFailed:
            return fmt_write_cstr(out, "parse failed");
    }
}

Result<i64, ParseError> parse(bool ok) {
    if (ok) {
        return Ok(42);
    }
    return Err(ParseFailed());
}

Result<i64, ParseError> add_one(bool ok) {
    i64 value = parse(ok)?;
    return Ok(value + 1);
}

i64 main() {
    i64 left = must(add_one(true));
    i64 right = expect(parse(true), "parse failed");

    switch (move add_one(false)) {
        case Ok(_):
            return 1;
        case Err(ParseFailed):
    }

    return left + right - 85;
}
