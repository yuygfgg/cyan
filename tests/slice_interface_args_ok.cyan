import /std.view;
interface<T> i64 measure(&T value);

struct Box {
    i64 value;
};

impl measure(&Box box) {
    return box.value;
}

i64 sum([]&measure values) {
    i64 i = 0;
    i64 total = 0;
    while (i < len(values)) {
        total = total + measure(values[i]);
        i++;
    }
    return total;
}

i64 main() {
    Box left = {4};
    Box right = {8};
    []&measure values = [&left, &right];
    if (sum(values) != 12) {
        return 1;
    }
    if (sum([&left, &right]) != 12) {
        return 1;
    }
    return 0;
}
