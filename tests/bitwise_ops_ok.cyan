i64 main() {
    i64 a = 1 | 2 & 4;
    i64 b = 1 | 6 ^ 3;
    i64 c = 12 ^ 10 & 7;
    i64 d = 1 << 3 + 1;
    i64 e = 32 >> 1 + 2;
    i64 f = ~0;
    if (a != 1) {
        return 1;
    }
    if (b != 5) {
        return 2;
    }
    if (c != 14) {
        return 3;
    }
    if (d != 16) {
        return 4;
    }
    if (e != 4) {
        return 5;
    }
    if ((f & 255) != 255) {
        return 6;
    }
    return 0;
}
