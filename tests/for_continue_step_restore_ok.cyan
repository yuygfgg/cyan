struct Token {
    i64 value;
};

impl drop(&mut Token token) {}

Token make(i64 value) {
    Token token = {value};
    return token;
}

i64 consume(Token token) {
    return token.value;
}

i64 main() {
    i64 sum = 0;

    for (Token token = make(1); sum < 3; token = make(sum + 2)) {
        sum = sum + consume(token);
        continue;
    }

    if (sum == 4) {
        return 0;
    }
    return 1;
}
