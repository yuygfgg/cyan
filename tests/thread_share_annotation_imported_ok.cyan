import modules.external_handle as ext;
import /std.ptr as ptr;
import /std.thread;

unchecked impl share(ext.Handle);

struct HandleTask {
    ext.Handle handle;
};

impl run_task(&HandleTask task) {}

i64 main() {
    ext.Handle handle = {ptr.null<void>()};
    HandleTask task = {handle};
    parallel_do([task]);
    return 0;
}
