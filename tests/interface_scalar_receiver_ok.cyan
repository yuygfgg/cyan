interface<T> i64 measure(&T value);

impl measure(&i64 value) {
    return *value;
}

i64 sum([]&measure values) {
    i64 i = 0;
    i64 total = 0;
    while (i < len(values)) {
        total = total + measure(values[i]);
        i++;
    }
    return total;
}

i64 call_dyn(&measure value) {
    return measure(value);
}

i64 main() {
    i64 left = 4;
    i64 right = 8;
    if (measure(right) != 8) {
        return 1;
    }
    if (call_dyn(left) != 4) {
        return 2;
    }
    if (sum([left, right]) != 12) {
        return 3;
    }
    return 0;
}
