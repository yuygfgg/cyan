import /std.sync;

struct SharedState {
    Mutex<i64> total;
};

struct Box {
    Arc<SharedState> state;
    i64 value;
};

void bump(&mut Box box) {
    i64 value = box.value;
    &SharedState state = arc_get(&box.state);
    MutexGuard<i64> guard = lock(&state.total);
    *guard.data = *guard.data + value;
}

i64 main() {
    SharedState state = {mutex_new(0)};
    Box box = {arc_new(state), 9};
    bump(&mut box);
    &SharedState shared = arc_get(&box.state);
    MutexGuard<i64> guard = lock(&shared.total);
    return *guard.data - 9;
}
