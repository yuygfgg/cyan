import /std.sync;
import /std.result;
import /std.error;

struct Token {
    &mut i64 counter;
};

impl drop(&mut Token token) {
    *token.counter = *token.counter + 1;
}

i64 main() {
    i64 count = 0;
    {
        Token token = {&mut count};
        Mutex<Token> mutex = must(mutex_new(token));
    }
    return count - 1;
}
