import /std.sync;
import /std.thread;
import /std.result;
import /std.error;

struct CountTask {
    Arc<Mutex<i64>> total;
};

impl run_once(&mut CountTask task) {
    &Mutex<i64> total = arc_get(&task.total);
    MutexGuard<i64> guard = lock(total);
    *guard.data = *guard.data + 1;
}

i64 main() {
    Arc<Mutex<i64>> root = must(arc_new(must(mutex_new(0))));

    CountTask task = {arc_clone(&root)};
    JoinHandle handle = must(spawn(task));
    join(&mut handle);
    join(&mut handle);

    &Mutex<i64> total = arc_get(&root);
    MutexGuard<i64> guard = lock(total);
    return *guard.data - 1;
}
