import /std.view as view;

i64 len(i64 value) {
    return value + 1;
}

i64 subslice(i64 value) {
    return value + 2;
}

i64 main() {
    []const char part = view.subslice("hello", 1, 3);
    if (len(41) != 42) {
        return 1;
    }
    if (subslice(40) != 42) {
        return 2;
    }
    if (view.len(part) != 3) {
        return 3;
    }
    if (part[0] != 'e' || part[2] != 'l') {
        return 4;
    }
    return 0;
}
