import /std.error;
import /std.heap as heap;
import /std.view;

void take_owner(&mut []i64 owner) {
    return;
}

i64 main() {
    i64* ptr = must(heap.malloc_array<i64>(1));
    unchecked {
        ptr[0] = 1;
        []i64 owner = from_raw_parts(ptr, 1);
        []i64 values = from_raw_parts_on(ptr, 1, owner);
        take_owner(&mut owner);
        heap.free_ptr(ptr);
        return values[0] - 1;
    }
    return 0;
}
