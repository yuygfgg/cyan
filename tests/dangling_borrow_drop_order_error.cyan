struct Token {
    i64 value;
};

impl drop(&mut Token token) {
    token.value = 0;
}

struct Holder {
    &Token ptr;
};

impl drop(&mut Holder holder) {
    i64 observed = holder.ptr.value;
    return;
}

i64 main() {
    Token stable = {0};
    Holder holder = {&stable};
    Token later = {1};
    holder.ptr = &later;
    return 0;
}
