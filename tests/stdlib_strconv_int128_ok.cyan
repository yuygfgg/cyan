import /std.cstr as cstr;
import /std.heap as heap;
import /std.mem as mem;
import /std.strconv as strconv;

i64 expect_text(char* buf, i64 written, const char* expected) {
    i64 expected_len = cstr.strlen(expected);
    if (written != expected_len) {
        return 1;
    }
    if (mem.memcmp(buf, expected, expected_len + 1) != 0) {
        return 2;
    }
    return 0;
}

i64 main() {
    char* buf = heap.malloc_array<char>(64);

    i128 min_i128 = -170141183460469231731687303715884105728;
    i128 max_i128 = 170141183460469231731687303715884105727;
    u128 max_u128 = 340282366920938463463374607431768211455 as u128;

    if (expect_text(buf, strconv.write_i128(buf, min_i128),
                    "-170141183460469231731687303715884105728") != 0) {
        return 1;
    }
    if (expect_text(buf, strconv.write_i128(buf, max_i128),
                    "170141183460469231731687303715884105727") != 0) {
        return 2;
    }
    if (expect_text(buf, strconv.write_u128(buf, max_u128),
                    "340282366920938463463374607431768211455") != 0) {
        return 3;
    }

    if (strconv.parse_i128("-170141183460469231731687303715884105728") != min_i128) {
        return 4;
    }
    if (strconv.parse_i128("+170141183460469231731687303715884105727") != max_i128) {
        return 5;
    }
    if (strconv.parse_i128("   -42xyz") != (-42 as i128)) {
        return 6;
    }
    if (strconv.parse_u128("340282366920938463463374607431768211455") != max_u128) {
        return 7;
    }
    if (strconv.parse_u128("  +18446744073709551616tail") != (18446744073709551616 as u128)) {
        return 8;
    }
    if (strconv.parse_u128("-1") != max_u128) {
        return 9;
    }

    heap.free_ptr(buf);
    return 0;
}
