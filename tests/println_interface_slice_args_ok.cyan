import /std.view;
interface<T> void fmt(&T value, &mut i64 out);

struct Box {
    i64 value;
};

impl fmt(&Box value, &mut i64 out) {
    *out = *out + value.value;
}

void render_into(&mut i64 out, const char* format_text, []&fmt args) {
    i64 i = 0;
    while (i < len(args)) {
        fmt(args[i], out);
        i++;
    }
}

void println(const char* format_text, []&fmt args) {
    i64 out = 0;
    render_into(&mut out, format_text, args);
}

i64 main() {
    Box left = {4};
    Box right = {8};
    i64 out = 0;
    render_into(&mut out, "{}", [&left, &right]);
    if (out != 12) {
        return 1;
    }
    println("{}", [&left, &right]);
    return 0;
}
