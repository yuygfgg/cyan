enum Action {
    Skip,
    Add(i64),
};

i64 sum_odd_values() {
    i64 sum = 0;

    for (i64 i = 0; i < 5; i++) {
        if (i % 2 == 0) {
            Action action = Skip();
            switch (move action) {
                case Skip:
                    continue;
                case Add(value):
                    sum = sum + value;
            }
        } else {
            Action action = Add(i);
            switch (move action) {
                case Skip:
                    continue;
                case Add(value):
                    sum = sum + value;
            }
        }
    }

    return sum;
}

i64 main() {
    if (sum_odd_values() == 4) {
        return 0;
    }
    return 1;
}
