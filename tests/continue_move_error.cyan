struct Token {
    i64 value;
};

impl drop(&mut Token token) {}

Token make(i64 value) {
    Token token = {value};
    return token;
}

i64 consume(Token token) {
    return token.value;
}

i64 bad() {
    Token token = make(1);

    while (true) {
        consume(token);
        continue;
    }

    return 0;
}
